# Copy to .env. Never commit secrets.
# Set to your public production origin before deployment.
SITE_URL=http://localhost:3000

# Supabase project (client-safe values may use NEXT_PUBLIC_).
# Find the Project URL and Publishable key in Supabase Dashboard > Connect.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only elevated key. Never prefix with NEXT_PUBLIC_ or expose to the browser.
# Prefer the new Secret key (sb_secret_...). Only use it in trusted server code.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Google OAuth client ID/secret are configured in Supabase Dashboard > Authentication > Providers > Google.
# Add the local and production callback URLs in Supabase Auth URL Configuration.

# Google Sheets (server-side only; never use NEXT_PUBLIC_ for these values).
# Create a service-account JSON key and save it at this ignored local path.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json
# Copy the spreadsheet ID from its URL and share the sheet with the service account.
GOOGLE_SHEETS_SPREADSHEET_ID=
# Optional paid-order destination; must be a tab range ending in !A:N.
GOOGLE_SHEETS_PAID_ORDERS_RANGE=Registrations!A:N
# Required by the scheduled/manual retry endpoint; use a random value of at least 32 characters.
SHEETS_SYNC_WORKER_SECRET=REPLACE_ME

# Ticket request configuration (names only; keep all credential values outside tracked files):
# SITE_URL must exactly match the browser origin used for local requests and the public origin in production.
# GOOGLE_SHEETS_SPREADSHEET_ID identifies the intended registration spreadsheet.
# Provide Google Application Default Credentials through a secure local or deployment identity.
# Do not reuse the revoked key. Production exposure requires verified proxy Origin handling and edge rate limiting/monitoring.

# SePay hosted checkout (server-only). Start in sandbox; checkout stays disabled
# until all three values are present. Merchant secret signs the checkout form.
# SEPAY_IPN_SECRET_KEY is a separate secret configured for the Gateway IPN header
# (X-Secret-Key); it is not the bank-webhook HMAC secret.
SEPAY_ENVIRONMENT=sandbox
SEPAY_MERCHANT_ID=
SEPAY_MERCHANT_SECRET=
SEPAY_IPN_SECRET_KEY=

# PayOS payment links (server-only). Checkout is intentionally disabled until
# the database, webhook, retry worker, and live-rail gates are approved.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_CHECKOUT_ENABLED=false
